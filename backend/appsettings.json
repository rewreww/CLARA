{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AIServices": {
    "MLServiceUrl": "http://localhost:8002",
    "ParserServiceUrl": "http://localhost:8000",
    "LLMServiceUrl": "http://localhost:8001"
  },
  "FileWatcher": {
    "FolderPath": ""
  },
  "PatientDocumentSync": {
    "Enabled": true,
    "IntervalMinutes": 1,
    "DebounceSeconds": 4,
    "DesktopNotificationsEnabled": true
  }
}
