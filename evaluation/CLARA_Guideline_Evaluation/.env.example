# This file is a template. Copy to .env and keep .env private.
# Evaluator: OpenAI-compatible chat endpoint, separate from CLARA's generator.
EVAL_LLM_MODEL=
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
# Embeddings: an OpenAI-compatible embeddings endpoint (can be a different provider).
EVAL_EMBEDDING_MODEL=
EVAL_EMBEDDING_BASE_URL=
EVAL_EMBEDDING_API_KEY=
# Blank base URL uses OpenAI's endpoint, requiring its credentials.
# A Grok chat endpoint does not imply availability of an embeddings endpoint.
